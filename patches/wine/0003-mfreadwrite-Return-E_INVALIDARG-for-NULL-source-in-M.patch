From d411ec08f80947b5d4b1fd39effec074d6b61116 Mon Sep 17 00:00:00 2001
From: Peter Stewart <peter@stewartmail.xyz>
Date: Sat, 21 Feb 2026 15:06:41 +1100
Subject: [PATCH 03/15] mfreadwrite: Return E_INVALIDARG for NULL source in
 MFCreateSourceReaderFromMediaSource.

Native returns E_INVALIDARG when called with a NULL media source pointer.
Without this check, the call crashes inside create_source_reader_from_object.

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
(cherry picked from commit 31969cac16d0c32b09173424cfc8bd6ad25adece)
---
 dlls/mfreadwrite/reader.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/dlls/mfreadwrite/reader.c b/dlls/mfreadwrite/reader.c
index a8a065de86b..cdec2721349 100644
--- a/dlls/mfreadwrite/reader.c
+++ b/dlls/mfreadwrite/reader.c
@@ -3135,6 +3135,9 @@ HRESULT WINAPI MFCreateSourceReaderFromMediaSource(IMFMediaSource *source, IMFAt
 {
     TRACE("%p, %p, %p.\n", source, attributes, reader);
 
+    if (!source)
+        return E_INVALIDARG;
+
     return create_source_reader_from_object((IUnknown *)source, attributes, &IID_IMFSourceReader, (void **)reader);
 }
 
